var on_demand_idle = 0
# An LLM call blocks one fill(); a 60s lock steal tears intel:items.
var stale_timeout = 600
var num_partitions = 1
include newspack-intelligence-core
include newspack-intelligence-collect
# Last, so a deployment's lines reach every node above. The deployment keeps
# this file in the user topology dir, empty if it has no settings of its own.
include newspack-intelligence-deployment
secure
