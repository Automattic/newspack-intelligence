var on_demand_idle = 0
# Fetches and LLM calls block one fill(); a 60s lock steal tears intel:items.
var stale_timeout = 600
var num_partitions = 1
include topic-probe
include newspack-intelligence-streams
include newspack-intelligence-collect
include newspack-intelligence-project
include newspack-intelligence-resolve
# Re-resolution spans two files: the ontology tee feeds the reresolver, which
# appends the items to re-resolve to intel:reresolve and checkpoints with the
# ontology Consumer.
make_node Reresolver reresolver intel:reresolve
connect_node intel:ontology:tee reresolver
command_node intel:ontology:consumer:config add_snapshot_node reresolver
secure
