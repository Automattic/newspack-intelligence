# The sources, each recording item_recorded events at its tier into intel:writer.
var num_partitions = 1
include topic-probe
include newspack-intelligence-streams
make_node Github_Source github public
cmd github:config set_vault_id github
cmd github:config set_interval 900
cmd github:config add_repo Automattic/newspack-ads
cmd github:config add_repo Automattic/newspack-activecampaign
cmd github:config add_repo Automattic/newspack-manager
cmd github:config add_repo Automattic/newspack-network
cmd github:config add_repo Automattic/newspack-plugin
make_node Linear_Source linear internal
cmd linear:config set_vault_id linear
cmd linear:config set_interval 900
cmd linear:config add_team NEWS
cmd linear:config add_team NPAI
cmd linear:config add_team NPPRO
cmd linear:config add_team NPPM
cmd linear:config add_team NPMIG
cmd linear:config add_team NPLAUNC
cmd linear:config add_team NPSUPP
cmd linear:config add_team NPPD
cmd linear:config add_team DSGNEWS
make_node Feed_Source feed public
cmd feed:config set_interval 1800
cmd feed:config set_client_feeds true
cmd feed:config add_url https://make.wordpress.org/core/feed/
cmd feed:config add_url https://wordpress.org/news/feed/
cmd feed:config add_url https://automattic.com/blog/feed/
cmd feed:config add_url https://www.niemanlab.org/feed/
cmd feed:config add_url https://knightfoundation.org/feed/
cmd feed:config add_url https://www.lenfestinstitute.org/feed/
cmd feed:config add_url https://lionpublishers.com/feed/
cmd feed:config add_url https://www.pressforward.news/feed/
cmd feed:config add_url https://www.pugpig.com/feed/
cmd feed:config add_url https://bluelena.io/feed/
cmd feed:config add_url https://localmedia.org/feed/
cmd feed:config add_url https://www.parse.ly/feed/
cmd feed:config add_url https://www.opennews.org/feed.xml
cmd feed:config add_url https://aan.org/feed/
cmd feed:config add_url https://www.nnaweb.org/index.php?rss=Article
cmd feed:config add_url https://www.mediaforwardfund.org/feed.rss
cmd feed:config add_url https://www.ire.org/feed/
cmd feed:config add_url https://www.rcfp.org/feed/
cmd feed:config add_url https://www.nobelprize.org/feed/
cmd feed:config add_url https://newsatknight.substack.com/feed
cmd feed:config add_url https://us2.campaign-archive.com/feed?u=491444f71ba82dbc51c55ccb9&id=784c02de83
cmd feed:config add_url https://us15.campaign-archive.com/feed?u=77370ff1d001f9bb991fed9e7&id=4c3cb20afe
connect_node github intel:writer
connect_node linear intel:writer
connect_node feed intel:writer
secure
